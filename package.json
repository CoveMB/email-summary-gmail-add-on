{
  "name": "email-summary-gmail-addon",
  "version": "0.1.0",
  "description": "Personal Google Workspace Gmail Add-on scaffold for EmailSummary.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean && rollup -c",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "clasp:push": "npm run build && clasp push",
    "clasp:pull": "clasp pull",
    "clasp:open": "clasp open-script",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@google/clasp": "^3.3.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/google-apps-script": "2.0.8",
    "eslint": "10.3.0",
    "eslint-config-prettier": "^10.1.5",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.60.3",
    "rollup-plugin-copy": "^3.5.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "4.1.5"
  }
}
